{
  "name": "utsavos",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next typegen && eslint --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:rules": "npx -y firebase-tools@15.34.0 emulators:exec --only firestore --project demo-utsavos \"vitest run --config vitest.rules.config.mts\"",
    "duplication": "npx -y jscpd@4.0.5 src --min-tokens 50 --threshold 1 --silent --ignore \"**/*.test.*\""
  },
  "dependencies": {
    "@google/genai": "^2.30.0",
    "firebase": "^13.0.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10",
    "eslint-config-next": "16.4.2",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "^7",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "^1.14.6"
    }
  },
  "engines": {
    "node": ">=22"
  }
}
