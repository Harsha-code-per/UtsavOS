# Gemini API key from https://aistudio.google.com/apikey (server-only, never NEXT_PUBLIC_)
GEMINI_API_KEY=
# Optional: comma-separated model ids, tried in order (defaults in src/lib/ai/planner.ts)
GEMINI_MODEL=
# Optional: set to 1 to run without Gemini, using the deterministic offline planner (used by e2e)
UTSAV_AI_OFFLINE=

# Firebase web config (Project settings > General > Your apps). These are public identifiers;
# access is enforced by firestore.rules, not by keeping them secret.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
